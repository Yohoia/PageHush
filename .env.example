# PageHush runtime
PAGEHUSH_API_HOST=127.0.0.1
PAGEHUSH_API_PORT=8787
PAGEHUSH_API_LOG_LEVEL=info
PAGEHUSH_API_ENABLE_CORS=true

# PostgreSQL
DATABASE_URL=postgresql://pagehush_app:change-me@127.0.0.1:15432/pagehush

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_BUCKET=pagehush-dev-assets
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_REGION=cn-hangzhou
MINIO_FORCE_PATH_STYLE=true

# Access authentication
# Generate with: npm run auth:hash
PAGEHUSH_ACCESS_CODE_HASH=scrypt$16384$8$1$change-me$change-me
PAGEHUSH_COOKIE_SECURE=false

# Worker orchestration
PAGEHUSH_WORKER_ENABLED=false
PAGEHUSH_WORKER_POLL_INTERVAL_MS=5000
