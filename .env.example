# PageHush runtime
PAGEHUSH_API_HOST=127.0.0.1
PAGEHUSH_API_PORT=8787

# These values will point to the services deployed on your server.
# Do not commit real credentials.
DATABASE_URL=postgresql://pagehush:change-me@127.0.0.1:5432/pagehush
MINIO_ENDPOINT=https://minio.example.com
MINIO_REGION=us-east-1
MINIO_BUCKET=pagehush
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_FORCE_PATH_STYLE=true

# Worker orchestration
PAGEHUSH_WORKER_ENABLED=false
PAGEHUSH_WORKER_POLL_INTERVAL_MS=5000
